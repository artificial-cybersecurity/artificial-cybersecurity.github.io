source "https://rubygems.org"

# Matches what GitHub Pages runs when it builds the site, so a local preview
# behaves like production. See https://pages.github.com/versions/
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Platform bits Jekyll needs on newer Rubies / Windows.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
